#   source "${QUILTRC_DIR}"/.quiltrc
# else
#   unset QUILTRC_DIR
# fi

## Setup .pc at submodule root and print it.
__setup_submodule_pc() (
  set -euo pipefail # subshell only

  # Ensure we are in a submodule, not the root.
  GIT_ROOT="$(git rev-parse --show-superproject-working-tree)"
  if [[ -z ${GIT_ROOT} ]]; then
    echo 'Please, use quilt in a submodule to avoid issues with the project root.' > /dev/stderr
    return 1
  fi
  SUBMODULE_ROOT="$(git rev-parse --show-toplevel)"
  SUBMODULE_DIR="$(realpath --canonicalize-existing --relative-to="${GIT_ROOT}" "${SUBMODULE_ROOT}")"

  # Exclude .pc from the worktree.
  GIT_EXCLUDE="$(git rev-parse --git-dir)/info/exclude"
  sed -i -E '/^\.pc\/?$/ q; $ a .pc/' "${GIT_EXCLUDE}"

  # Enforce $QUILT_PC with expected values.
  QUILT_PC="${SUBMODULE_ROOT}/.pc"
  mkdir -p "${QUILT_PC}" 1>&2
  printf '../.patches/%s\n' "${SUBMODULE_DIR}" > "${QUILT_PC}/.quilt_patches"
  printf '.series\n' > "${QUILT_PC}/.quilt_series"
  printf '2\n' > "${QUILT_PC}/.version"

  # Send $QUILT_PC out of the subshell.
  printf '%s\n' "${QUILT_PC}"
)

## See /etc/quilt.quiltrc
# shellcheck disable=SC2310
if ! QUILT_PC="$(__setup_submodule_pc)"; then
  exit 1
fi
export QUILT_PC

# Options passed to GNU diff when generating patches.
export QUILT_DIFF_OPTS='--show-c-function'

# Options passed to diffstat when generating patch statistics.
#export QUILT_DIFFSTAT_OPTS="-f0"

# Options to pass to commands (QUILT_${COMMAND}_ARGS).
export QUILT_PUSH_ARGS='--color=auto'
export QUILT_DIFF_ARGS='-u -pab --no-timestamps --color=never'
export QUILT_REFRESH_ARGS='-u -pab --diffstat --sort --no-timestamps'
export QUILT_SERIES_ARGS='--color=auto'
export QUILT_PATCHES_ARGS='--color=auto'

# Remove prefix from patch names.
unset QUILT_PATCHES_PREFIX

# Customize pager
case "${QUILT_COMMAND:-}" in
  diff | refresh)
    # show side-by-side diff
    export QUILT_PAGER=delta
    ;;
  annotate)
    # add filename for syntax highlighting
    export QUILT_PAGER="bat --file-name ${!#} -p"
    ;;
  *)
    # page only when needed
    export QUILT_PAGER='bat -p'
    ;;
esac

# Customize editor
case "${QUILT_COMMAND:-}" in
  header | mail)
    # use markdown for patches
    export EDITOR='nano --syntax markdown'
    ;;
  *)
    # no syntax for editing files
    export EDITOR=nano
    ;;
esac
