# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Tom Payne <twpayne@gmail.com>
# Contributor:  <godeater@gmail.com>

pkgname=chezmoi
pkgver=2.69.0
pkgrel=1.2
pkgdesc="Manage your dotfiles across multiple machines"
arch=('x86_64')
url='https://www.chezmoi.io/'
license=('MIT')
makedepends=('go' 'git')
depends=('glibc')
checkdepends=('zip')
optdepends=('git: clone remote dotfiles over ssh')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/twpayne/chezmoi/archive/v${pkgver}.tar.gz"
        'https://github.com/go-sprout/sprout/pull/157.patch'
        'https://github.com/go-sprout/sprout/pull/160.patch')
sha512sums=('8fc2d5232914a9004377d14b2397bca3450a3023b4fbe460dc60b119dfec63e1f172e817f229f683c530d4ccd08576fca0c843e6cab77ca75e400936ec14bee9'
            '3376d8dc6f7053c3d12bdb43d6b7734471626ee3255e99a0e91714227d1febd58739e2e4c93a3ca9fa932a559b28a728f13c0b3fbe8e9a71d016e95952e60479'
            '7879e4562a0988fdb5f50b06fc8bcd4c5f9aab7bf0c0266eea7d87f81e9c4e11acba95f0dd511a6bc5613b457822b77b0ea4db52803ead3d6f00920dc357ad0a')

prepare() {
  cd "$pkgname-$pkgver"

  go mod vendor
  git -C vendor/github.com/go-sprout/sprout apply --reject "$srcdir/157.patch" || :
  git -C vendor/github.com/go-sprout/sprout apply --reject "$srcdir/160.patch" || :
}

build() {
  cd "$pkgname-$pkgver"

  export CGO_LDFLAGS="$LDFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export GOPROXY=off
  go build \
    -buildmode=pie \
    -mod=vendor \
    -tags noupgrade \
    -ldflags "-compressdwarf=false \
              -X github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/$pkgname \
              -X main.version=$pkgver+sprout-157.sprout-160 \
              -X main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date=@$SOURCE_DATE_EPOCH) \
              -extldflags \"$LDFLAGS\"" \
    .
}

check() {
  cd "$pkgname-$pkgver"

  go test -v ./...
}

package() {
  cd "$pkgname-$pkgver"

  install -D "$pkgname" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 completions/chezmoi-completion.bash "$pkgdir/usr/share/bash-completion/completions/chezmoi"
  install -Dm644 completions/chezmoi.fish "$pkgdir/usr/share/fish/vendor_completions.d/chezmoi.fish"
  install -Dm644 completions/chezmoi.zsh "$pkgdir/usr/share/zsh/site-functions/_chezmoi"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
