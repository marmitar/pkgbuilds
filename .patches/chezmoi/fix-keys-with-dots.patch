Author: Tiago de Paula <tiagodepalves@gmail.com>
Date: Fri, 9 Jan 2026 00:24:23 -0300
Last-Update: 2026-06-03
Subject: [PATCH] Update sprout to main.

Includes <https://github.com/go-sprout/sprout/pull/160>
---
 .SRCINFO |    2 +-
 PKGBUILD |    7 +++++--
 2 files changed, 6 insertions(+), 3 deletions(-)

Index: b/.SRCINFO
===================================================================
--- a/.SRCINFO
+++ b/.SRCINFO
@@ -1,7 +1,7 @@
 pkgbase = chezmoi
 	pkgdesc = Manage your dotfiles across multiple machines
 	pkgver = 2.70.4
-	pkgrel = 1.1
+	pkgrel = 1.2
 	url = https://www.chezmoi.io/
 	arch = x86_64
 	license = MIT
Index: b/PKGBUILD
===================================================================
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -5,7 +5,7 @@
 
 pkgname=chezmoi
 pkgver=2.70.4
-pkgrel=1.1
+pkgrel=1.2
 pkgdesc="Manage your dotfiles across multiple machines"
 arch=('x86_64')
 url='https://www.chezmoi.io/'
@@ -25,6 +25,9 @@ prepare() {
 
   git apply --reverse --reject ../a08a575a051dbe93b9dadb63f683e437af1337ba.patch || :
 
+  go mod edit -replace github.com/go-sprout/sprout=github.com/go-sprout/sprout@3b77ce5490dd49ac5164399823c8637ba4193f24
+  go mod tidy
+
   go mod download
 }
 
@@ -42,7 +45,7 @@ build() {
     -tags noupgrade \
     -ldflags "-compressdwarf=false \
               -X github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/$pkgname \
-              -X main.version=$pkgver+sprout \
+              -X main.version=$pkgver+sprout-3b77ce54 \
               -X main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date=@$SOURCE_DATE_EPOCH) \
               -extldflags \"$LDFLAGS\"" \
     .
