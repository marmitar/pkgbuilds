---
 .SRCINFO |    6 +++---
 PKGBUILD |   19 ++++++++++++-------
 2 files changed, 15 insertions(+), 10 deletions(-)

Index: b/.SRCINFO
===================================================================
--- a/.SRCINFO
+++ b/.SRCINFO
@@ -1,7 +1,7 @@
 pkgbase = chezmoi
 	pkgdesc = Manage your dotfiles across multiple machines
 	pkgver = 2.72.0
-	pkgrel = 1
+	pkgrel = 1.1
 	url = https://www.chezmoi.io/
 	arch = x86_64
 	license = MIT
@@ -11,7 +11,7 @@ pkgbase = chezmoi
 	depends = glibc
 	optdepends = git: clone remote dotfiles over ssh
 	options = !lto
-	source = chezmoi-2.72.0.tar.gz::https://github.com/twpayne/chezmoi/archive/v2.72.0.tar.gz
-	sha512sums = 56c750fca8410f5cc8b7cf7d81ce1c8c373954323741e8f95cf8576f0995b9b3ea276343f3b19448c557877029ba78320205410f2c798adc101aec4572f4c3f1
+	source = chezmoi-d969d39c82998301ca87582e27f01127cc626a65.tar.gz::https://github.com/twpayne/chezmoi/archive/d969d39c82998301ca87582e27f01127cc626a65.tar.gz
+	sha512sums = 080b7543497a5a1ed76b27d475d0be552785383c4887b50c79665644173efd24892ca03b3a0c88759e9c6349d801d44f5f072255f9e29f48300cd8e77b3cd7c8
 
 pkgname = chezmoi
Index: b/PKGBUILD
===================================================================
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -15,17 +15,20 @@ depends=('glibc')
 checkdepends=('zip')
 optdepends=('git: clone remote dotfiles over ssh')
 options=('!lto')
-source=("${pkgname}-${pkgver}.tar.gz::https://github.com/twpayne/chezmoi/archive/v${pkgver}.tar.gz")
-sha512sums=('56c750fca8410f5cc8b7cf7d81ce1c8c373954323741e8f95cf8576f0995b9b3ea276343f3b19448c557877029ba78320205410f2c798adc101aec4572f4c3f1')
+_commit=d969d39c82998301ca87582e27f01127cc626a65
+source=("${pkgname}-${_commit}.tar.gz::https://github.com/twpayne/chezmoi/archive/${_commit}.tar.gz")
+sha512sums=('080b7543497a5a1ed76b27d475d0be552785383c4887b50c79665644173efd24892ca03b3a0c88759e9c6349d801d44f5f072255f9e29f48300cd8e77b3cd7c8')
 
 prepare() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
+
+  git apply --reverse --reject ../a08a575a051dbe93b9dadb63f683e437af1337ba.patch || :
 
   go mod download
 }
 
 build() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   export CGO_LDFLAGS="$LDFLAGS"
   export CGO_CFLAGS="$CFLAGS"
@@ -38,20 +41,20 @@ build() {
     -tags noupgrade \
     -ldflags "-compressdwarf=false \
               -X github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/$pkgname \
-              -X main.version=$pkgver \
+              -X main.version=$pkgver+sprout \
               -X main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date=@$SOURCE_DATE_EPOCH) \
               -extldflags \"$LDFLAGS\"" \
     .
 }
 
 check() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   go test -v ./...
 }
 
 package() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   install -D "$pkgname" "$pkgdir/usr/bin/$pkgname"
 
@@ -61,3 +64,5 @@ package() {
 
   install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 }
+
+pkgrel+=.1
