--- a/PKGBUILD
+++ b/PKGBUILD
@@ -15,12 +15,17 @@ depends=('glibc')
 checkdepends=('zip')
 optdepends=('git: clone remote dotfiles over ssh')
 options=('!lto')
-source=("${pkgname}-${pkgver}.tar.gz::https://github.com/twpayne/chezmoi/archive/v${pkgver}.tar.gz")
-sha512sums=('56c750fca8410f5cc8b7cf7d81ce1c8c373954323741e8f95cf8576f0995b9b3ea276343f3b19448c557877029ba78320205410f2c798adc101aec4572f4c3f1')
+_commit=d969d39c82998301ca87582e27f01127cc626a65
+source=("${pkgname}-${pkgver}.tar.gz::https://github.com/twpayne/chezmoi/archive/v${pkgver}.tar.gz"
+        "${_commit}.patch::https://github.com/twpayne/chezmoi/compare/v${pkgver}...${_commit}.patch")
+sha512sums=('56c750fca8410f5cc8b7cf7d81ce1c8c373954323741e8f95cf8576f0995b9b3ea276343f3b19448c557877029ba78320205410f2c798adc101aec4572f4c3f1'
+            '7059e9387a91719ec5cc3c4f3cd12e1ff0382ee0c1e5dda10f6c23f9292c83189ff05539fec85c77d47f0d6960c84995a465f7382aa67acbc1c8d4f36ceacd76')
 
 prepare() {
   cd "$pkgname-$pkgver"
 
+  git apply "../${_commit}.patch"
+
   go mod download
 }
 
@@ -32,15 +37,18 @@ build() {
   export CGO_CPPFLAGS="$CPPFLAGS"
   export CGO_CXXFLAGS="$CXXFLAGS"
   export GOPROXY=off
+  local go_ldflags=(
+    -compressdwarf=false
+    -X "'github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/${pkgname}'" \
+    -X "'main.version=${pkgver}+${_commit:0:8}'" \
+    -X "'main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date="@${SOURCE_DATE_EPOCH}")'" \
+    -extldflags "'${LDFLAGS}'"
+  )
   go build \
     -buildmode=pie \
     -mod=readonly \
     -tags noupgrade \
-    -ldflags "-compressdwarf=false \
-              -X github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/$pkgname \
-              -X main.version=$pkgver \
-              -X main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date=@$SOURCE_DATE_EPOCH) \
-              -extldflags \"$LDFLAGS\"" \
+    -ldflags "${go_ldflags[*]}" \
     .
 }
 
@@ -61,3 +69,5 @@ package() {
 
   install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 }
+
+pkgrel+=.1
