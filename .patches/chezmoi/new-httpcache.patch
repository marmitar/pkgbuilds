Author: Tiago de Paula <tiagodepalves@gmail.com>
Date: Wed, 03 Jun 2026 23:39:09 -0300
Last-Update: 2026-07-05
Subject: [PATCH] Test new http cache;

See https://github.com/twpayne/chezmoi/pull/5117
---
 .SRCINFO   |    6 +++---
 .gitignore |    1 +
 PKGBUILD   |   17 +++++++++--------
 3 files changed, 13 insertions(+), 11 deletions(-)

Index: b/.SRCINFO
===================================================================
--- a/.SRCINFO
+++ b/.SRCINFO
@@ -1,7 +1,7 @@
 pkgbase = chezmoi
 	pkgdesc = Manage your dotfiles across multiple machines
 	pkgver = 2.70.5
-	pkgrel = 1
+	pkgrel = 1.10
 	url = https://www.chezmoi.io/
 	arch = x86_64
 	license = MIT
@@ -11,7 +11,7 @@ pkgbase = chezmoi
 	depends = glibc
 	optdepends = git: clone remote dotfiles over ssh
 	options = !lto
-	source = chezmoi-2.70.5.tar.gz::https://github.com/twpayne/chezmoi/archive/v2.70.5.tar.gz
-	sha512sums = 09eeeb1a55ec963751fdd4d1ccc0f4b0d7125b668665ba95bafdeda433e173882a439447052babacb73178e2afeb8af6eaf6ea7c343d7305e13f4c5c322ec7f3
+	source = chezmoi-7974a61848b0a5824c9a8ec549491c1336d6a59c.tar.gz::https://github.com/twpayne/chezmoi/archive/7974a61848b0a5824c9a8ec549491c1336d6a59c.tar.gz
+	sha512sums = 44f374def874f234b368c65fe0778966d739c7a78443a5fca154a47dbded3667d1082dbec6c2b6a0d0d5991b95227914d8dfa9f97c6e7f2a7bc844d2002b4ddc
 
 pkgname = chezmoi
Index: b/.gitignore
===================================================================
--- a/.gitignore
+++ b/.gitignore
@@ -1,3 +1,4 @@
 *.pkg.tar.*
 *.tar.gz
 *.patch
+!new-httpcache.patch
Index: b/PKGBUILD
===================================================================
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -5,7 +5,7 @@
 
 pkgname=chezmoi
 pkgver=2.70.5
-pkgrel=1
+pkgrel=1.10
 pkgdesc="Manage your dotfiles across multiple machines"
 arch=('x86_64')
 url='https://www.chezmoi.io/'
@@ -15,17 +15,18 @@ depends=('glibc')
 checkdepends=('zip')
 optdepends=('git: clone remote dotfiles over ssh')
 options=('!lto')
-source=("${pkgname}-${pkgver}.tar.gz::https://github.com/twpayne/chezmoi/archive/v${pkgver}.tar.gz")
-sha512sums=('09eeeb1a55ec963751fdd4d1ccc0f4b0d7125b668665ba95bafdeda433e173882a439447052babacb73178e2afeb8af6eaf6ea7c343d7305e13f4c5c322ec7f3')
+_commit=7974a61848b0a5824c9a8ec549491c1336d6a59c
+source=("${pkgname}-${_commit}.tar.gz::https://github.com/twpayne/chezmoi/archive/${_commit}.tar.gz")
+sha512sums=('44f374def874f234b368c65fe0778966d739c7a78443a5fca154a47dbded3667d1082dbec6c2b6a0d0d5991b95227914d8dfa9f97c6e7f2a7bc844d2002b4ddc')
 
 prepare() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   go mod download
 }
 
 build() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   export CGO_LDFLAGS="$LDFLAGS"
   export CGO_CFLAGS="$CFLAGS"
@@ -38,20 +39,20 @@ build() {
     -tags noupgrade \
     -ldflags "-compressdwarf=false \
               -X github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/$pkgname \
-              -X main.version=$pkgver \
+              -X main.version=$pkgver+${_commit:0:7} \
               -X main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date=@$SOURCE_DATE_EPOCH) \
               -extldflags \"$LDFLAGS\"" \
     .
 }
 
 check() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   go test -v ./...
 }
 
 package() {
-  cd "$pkgname-$pkgver"
+  cd "$pkgname-$_commit"
 
   install -D "$pkgname" "$pkgdir/usr/bin/$pkgname"
