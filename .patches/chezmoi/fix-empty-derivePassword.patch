 	url = https://www.chezmoi.io/
 	arch = x86_64
 	license = MIT
@@ -13,7 +13,9 @@ pkgbase = chezmoi
 	options = !lto
 	source = chezmoi-2.72.0.tar.gz::https://github.com/twpayne/chezmoi/archive/v2.72.0.tar.gz
 	source = d969d39c82998301ca87582e27f01127cc626a65.patch::https://github.com/twpayne/chezmoi/compare/v2.72.0...d969d39c82998301ca87582e27f01127cc626a65.patch
