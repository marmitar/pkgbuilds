Index: b/PKGBUILD
===================================================================
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -17,16 +17,19 @@ optdepends=('git: clone remote dotfiles
 options=('!lto')
 _commit=d969d39c82998301ca87582e27f01127cc626a65
 source=("${pkgname}-${pkgver}.tar.gz::https://github.com/twpayne/chezmoi/archive/v${pkgver}.tar.gz"
-        "${_commit}.patch::https://github.com/twpayne/chezmoi/compare/v${pkgver}...${_commit}.patch")
+        "${_commit}.patch::https://github.com/twpayne/chezmoi/compare/v${pkgver}...${_commit}.patch"
+        'https://github.com/go-sprout/sprout/pull/157.patch')
 sha512sums=('56c750fca8410f5cc8b7cf7d81ce1c8c373954323741e8f95cf8576f0995b9b3ea276343f3b19448c557877029ba78320205410f2c798adc101aec4572f4c3f1'
-            '7059e9387a91719ec5cc3c4f3cd12e1ff0382ee0c1e5dda10f6c23f9292c83189ff05539fec85c77d47f0d6960c84995a465f7382aa67acbc1c8d4f36ceacd76')
+            '7059e9387a91719ec5cc3c4f3cd12e1ff0382ee0c1e5dda10f6c23f9292c83189ff05539fec85c77d47f0d6960c84995a465f7382aa67acbc1c8d4f36ceacd76'
+            '3376d8dc6f7053c3d12bdb43d6b7734471626ee3255e99a0e91714227d1febd58739e2e4c93a3ca9fa932a559b28a728f13c0b3fbe8e9a71d016e95952e60479')
 
 prepare() {
   cd "$pkgname-$pkgver"
 
   git apply "../${_commit}.patch"
 
-  go mod download
+  go mod vendor
+  git -C vendor/github.com/go-sprout/sprout apply --reject ../157.patch || :
 }
 
 build() {
@@ -40,14 +43,14 @@ build() {
   local go_ldflags=(
     -compressdwarf=false
     -X "'github.com/twpayne/chezmoi/cmd.DocsDir=/usr/share/doc/${pkgname}'"
-    -X "'main.version=${pkgver}+${_commit:0:8}'"
+    -X "'main.version=${pkgver}+${_commit:0:8}.derivePassword'"
     -X "'main.date=$(date -u +'%Y-%m-%dT%H:%M:%SZ' --date="@${SOURCE_DATE_EPOCH}")'"
     -extldflags "'${LDFLAGS}'"
   )
 
   go build \
     -buildmode=pie \
-    -mod=readonly \
+    -mod=vendor \
     -tags noupgrade \
     -ldflags "${go_ldflags[*]}" \
     .
@@ -71,4 +74,4 @@ package() {
   install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 }
 
-pkgrel+=.1
+pkgrel+=.2
