Author: Tiago de Paula <tiagodepalves@gmail.com>
Date: Thu, 5 Feb 2026 23:59:22 -0300
Last-Update: 2026-08-01
Subject: [WIP] Split PSW package groups
---
 PKGBUILD |  158 ++++++++++++++++++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 136 insertions(+), 22 deletions(-)

Index: b/PKGBUILD
===================================================================
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -1,20 +1,20 @@
 # Maintainer: marmis <tiagodepalves@gmail.com>
 # Contributor: "marmis" Tiago de Paula <tiagodepalves@gmail.com>
 
-pkgname=intel-sgx-psw-bin
+pkgbase=intel-sgx-psw-bin
+pkgname=(
+  intel-sgx-psw-common-bin
+  intel-sgx-aesm-bin
+  intel-sgx-qgs-bin
+  intel-sgx-dcap-bin
+  intel-sgx-ra-bin
+)
 pkgdesc='Intel® Software Guard Extensions Platform Software for Linux* OS'
 pkgver=2.30
 pkgrel=1
 url='https://github.com/intel/confidential-computing.sgx.sdk'
 arch=(x86_64)
 license=('BSD-3-Clause AND LicenseRef-Intel-SGX-Third-Party') # https://github.com/intel/confidential-computing.sgx.sdk/blob/main/License.txt
-depends=('glibc' 'libstdc++' 'bash')
-optdepends=(
-  'protobuf-21: required for the AESM service'
-  'nodejs: for running the SGX DCAP PCCS Server'
-  'curl: required for SGX Remote Attestation Service (RA)'
-  'boost183: required by the TDX Quote Generation Service (QGS)'
-)
 provides=("intel-sgx-psw=${pkgver}")
 conflicts=('intel-sgx-psw')
 options=(!strip !debug)
@@ -28,23 +28,31 @@ b2sums=('18d61906b851196a0f955b1cdbf86f2
 # See https://wiki.archlinux.org/title/Arch_package_guidelines#Directories
 _fix_non_standard_paths() {
   # /etc/udev is for user files, packages should use /usr/lib/udev instead
-  install -vd "${pkgdir}/usr/lib/udev/"
-  mv -v --no-copy "${pkgdir}/etc/udev/rules.d" \
-    -T "${pkgdir}/usr/lib/udev/rules.d"
-  rmdir -v "${pkgdir}/etc/udev"
+  if [[ -d "${pkgdir}/etc/udev" ]]; then
+    install -vd "${pkgdir}/usr/lib/udev/"
+    mv -v --no-copy "${pkgdir}/etc/udev/rules.d" \
+      -T "${pkgdir}/usr/lib/udev/rules.d"
+    rmdir -v "${pkgdir}/etc/udev"
+  fi
 
   # Debian has a /usr/lib/$TARGET folder, but not in Arch
-  mv -v -t "${pkgdir}/usr/lib/" \
-    --no-copy "${pkgdir}/usr/lib/${CARCH}-linux-gnu"/*.so*
-  rmdir -v "${pkgdir}/usr/lib/${CARCH}-linux-gnu"
+  if [[ -d "${pkgdir}/usr/lib/${CARCH}-linux-gnu" ]]; then
+    mv -v -t "${pkgdir}/usr/lib/" \
+      --no-copy "${pkgdir}/usr/lib/${CARCH}-linux-gnu"/*.so*
+    rmdir -v "${pkgdir}/usr/lib/${CARCH}-linux-gnu"
+  fi
 
   # Debian has an actual /lib folder, which in Arch is just a symlink to /usr/lib
-  mv -v -t "${pkgdir}/usr/lib/systemd/system/" \
-    --no-copy "${pkgdir}/lib/systemd/system"/*.service
-  rmdir "${pkgdir}/lib/systemd/system" "${pkgdir}/lib/systemd" "${pkgdir}/lib"
+  if [[ -d "${pkgdir}/lib/systemd/system" ]]; then
+    mv -v -t "${pkgdir}/usr/lib/systemd/system/" \
+      --no-copy "${pkgdir}/lib/systemd/system"/*.service
+    rmdir "${pkgdir}/lib/systemd/system" "${pkgdir}/lib/systemd" "${pkgdir}/lib"
+  fi
 
   # Debian also supports /include, which should be empty here
-  rmdir -v "${pkgdir}/include"
+  if [[ -d "${pkgdir}/include" ]]; then
+    rmdir -v "${pkgdir}/include"
+  fi
 }
 
 # Update symbolic links generated by the installer (namcap rule: symlink).
@@ -53,23 +61,129 @@ _fix_symlink() {
     -fT "${1}"
 }
 
-package() {
-  find sgx_debian_local_repo -name '*.deb' -print \
+_pick() {
+  find sgx_debian_local_repo \( -name "${1}.deb" -or -name "${1}-dbgsym.deb" \) -print \
     -exec sh -euc 'ar -p "$1" -O data.tar.xz | tar -x --xz -C "$2"' -- {} "${pkgdir}" \;
+}
+
+package_intel-sgx-psw-common-bin() {
+  pkgdesc='Intel® SGX Platform Software (PSW) for Linux* OS'
+  depends=('glibc' 'gcc-libs' 'protobuf-21')
+  conflicts=('intel-sgx-psw-common')
+
+  _pick libsgx-enclave-common
+  _pick libsgx-enclave-common-dev
+  _pick libsgx-headers
+  _pick libsgx-launch
+  _pick libsgx-launch-dev
+  _pick libsgx-urts
+  _fix_non_standard_paths
 
   # required users and groups
   install -vD -m644 intel-sgx-sysusers.conf \
     -T "${pkgdir}/usr/lib/sysusers.d/intel-sgx.conf"
 
   # composed license
-  install -vD -t "${pkgdir}/usr/share/licenses/${pkgname}/" \
+  install -vD -t "${pkgdir}/usr/share/licenses/intel-sgx-psw-bin/" \
     -m644 "${pkgdir}/usr/share/doc/libsgx-enclave-common/copyright"
+}
 
+package_intel-sgx-aesm-bin() {
+  pkgdesc='Intel® SGX Application Enclave Services Manager (AESM)'
+  depends=('intel-sgx-psw-common-bin' 'glibc' 'gcc-libs' 'protobuf-21')
+  optdepends=('intel-sgx-qgs-bin: for the Untrusted AE (UAE) Service')
+  conflicts=('intel-sgx-aesm')
+
+  _pick sgx-aesm-service
+  _pick libsgx-uae-service
+  _pick libsgx-ae-epid
+  _pick libsgx-ae-id-enclave
+  _pick libsgx-ae-le
+  _pick libsgx-ae-pce
+  _pick libsgx-ae-qe3
+  _pick libsgx-ae-qve
+  _pick libsgx-aesm-ecdsa-plugin
+  _pick libsgx-aesm-epid-plugin
+  _pick libsgx-aesm-launch-plugin
+  _pick libsgx-aesm-pce-plugin
+  _pick libsgx-aesm-quote-ex-plugin
+  _pick libsgx-qe3-logic
+  _pick libsgx-epid-dev
+  _pick libsgx-epid
+  _pick libsgx-pce-logic
   _fix_non_standard_paths
+
   _fix_symlink "${pkgdir}/opt/intel/sgx-aesm-service/aesm/libsgx_pce.signed.so"
   _fix_symlink "${pkgdir}/opt/intel/sgx-aesm-service/aesm/libsgx_pce.signed.so.1"
   _fix_symlink "${pkgdir}/opt/intel/sgx-aesm-service/aesm/libsgx_qe3.signed.so"
   _fix_symlink "${pkgdir}/opt/intel/sgx-aesm-service/aesm/libsgx_qe3.signed.so.1"
+
+  # TODO: install -Dm644 intel-sgx-aesm-sysusers.conf "${pkgdir}"/usr/lib/sysusers.d/intel-sgx-aesm.conf
+}
+
+package_intel-sgx-qgs-bin() {
+  pkgdesc='Intel® SGX Quote Generation Service (QGS)'
+  depends=('intel-sgx-psw-common-bin' 'glibc' 'gcc-libs' 'protobuf-21' 'boost183')
+  optdepends=(
+    'intel-sgx-aesm-bin: for Trust Domain Extension (TDX) QE logic'
+    'intel-sgx-dcap-bin: for Trust Domain Extension (TDX) QE logic'
+  )
+  conflicts=('intel-sgx-qgs')
+
+  _pick tdx-qgs
+  _pick libsgx-tdx-logic
+  _pick libsgx-tdx-logic-dev
+  _pick libsgx-quote-ex
+  _pick libsgx-quote-ex-dev
+  _pick libsgx-ae-tdqe
+  _pick libtdx-attest
+  _pick libtdx-attest-dev
+  _fix_non_standard_paths
+
+  # TODO: install -Dm644 intel-sgx-qgs-sysusers.conf "${pkgdir}"/usr/lib/sysusers.d/intel-sgx-qgs.conf
+}
+
+package_intel-sgx-dcap-bin() {
+  pkgdesc='Intel® SGX Data Center Attestation Primitives (DCAP)'
+  depends=('intel-sgx-psw-common-bin' 'intel-sgx-awsm-bin' 'glibc' 'gcc-libs' 'curl')
+  optdepends=( # SPLIT?
+    'bash: for the Provisioning Certificate Caching Service'
+    'python: for the Provisioning Certificate Caching Service'
+    'python-pip: Provisioning Certificate Caching Service'
+    'python-venv: Provisioning Certificate Caching Service'
+    'npm: for the Provisioning Certificate Caching Service'
+    'nodejs: Provisioning Certificate Caching Service'
+  )
+  conflicts=('intel-sgx-dcap')
+
+  _pick sgx-dcap-pccs
+  _pick libsgx-dcap-ql
+  _pick libsgx-dcap-ql-dev
+  _pick libsgx-dcap-default-qpl
+  _pick libsgx-dcap-default-qpl-dev
+  _pick libsgx-dcap-quote-verify
+  _pick libsgx-dcap-quote-verify-dev
+  _pick intel-tee-pccs-admin-tool
+  _pick intel-tee-pcs-client-tool
+  _pick sgx-pck-id-retrieval-tool
+  _pick tee-appraisal-tool
+  _fix_non_standard_paths
+
   _fix_symlink "${pkgdir}/opt/intel/sgx-pck-id-retrieval-tool/libsgx_id_enclave.signed.so.1"
   _fix_symlink "${pkgdir}/opt/intel/sgx-pck-id-retrieval-tool/libsgx_pce.signed.so.1"
+
+  # TODO: install -Dm644 intel-sgx-pccs-sysusers.conf "${pkgdir}"/usr/lib/sysusers.d/intel-sgx-pccs.conf
+}
+
+package_intel-sgx-ra-bin() {
+  pkgdesc='Intel® SGX Remote Attestation (RA) Service'
+  depends=('glibc' 'gcc-libs')
+  conflicts=('intel-sgx-ra')
+
+  _pick sgx-ra-service
+  _pick libsgx-ra-network
+  _pick libsgx-ra-network-dev
+  _pick libsgx-ra-uefi
+  _pick libsgx-ra-uefi-dev
+  _fix_non_standard_paths
 }
