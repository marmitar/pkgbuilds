{
  "file_types": {
    "Git Ignore": [
      "**/*.series",
    ],
    "ini": [
      ".shellcheckrc",
      "**/*.SRCINFO",
    ],
    "Shell Script": [
      "**/*.install",
    ],
    "Plain Text": [
      "**/*.pam",
    ],
  },
  "wrap_guides": [100],
}
